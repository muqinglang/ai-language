# justSpeak — environment for docker-compose.
# Copy to `.env` in the repo root (it is gitignored) and fill in what you need.
# Everything here has a safe default EXCEPT the secrets you should set for prod.

# ──────────────────────────── Secrets (set these) ────────────────────────────
# Postgres password. Only read at first `initdb`; changing it later does NOT
# rotate an existing database's password. Keep it alphanumeric (it goes into a
# URL). Default below is a throwaway dev value.
POSTGRES_PASSWORD=justspeak_dev

# Signs login JWTs. Use a long random string in production, e.g.
#   openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=10080

# Admin account created by seed.py on first boot. If ADMIN_PASSWORD is empty a
# strong random one is generated and printed to the api logs exactly once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Encrypts learner-supplied third-party API keys at rest (the "bring your own
# key" feature). Unset → that feature is OFF (the endpoint 503s) rather than
# storing spendable credentials in plaintext. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this value makes every already-stored user key undecryptable.
CREDENTIAL_ENC_KEY=

# ──────────────────────────── Behaviour toggles ─────────────────────────────
# true → seed fake sample episodes (local dev). Set false for a clean/prod DB.
SEED_DEMO=true
# true → anyone can self-register; false → invite/admin-created accounts only.
AUTH_SELF_SIGNUP=true
# New self-signup accounts get this many trial days (0 = permanent).
AUTH_NEW_USER_TRIAL_DAYS=7
# Enables the Google Sign-In button. Leave empty to hide it.
GOOGLE_CLIENT_ID=

# ──────────────────────────── LLM providers ─────────────────────────────────
# The pipeline (YouTube import) and, as a fallback, chat use these. Learners can
# also bring their own keys in-app (see docs/BYOK.md); these are the platform
# fallback. Leave all blank to run without server-side LLM (BYOK-only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ──────────────────────────── TTS (platform fallback) ───────────────────────
# Optional platform ElevenLabs. If empty, /api/tts returns 503 and the browser
# falls back to free Web Speech. Learners can configure their own TTS in-app.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ──────────────────────────── Outbound proxy (optional) ─────────────────────
# yt-dlp needs to reach YouTube. If your server can't (blocked region), route
# through a proxy on your host, e.g. http://host.docker.internal:7890
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,api
